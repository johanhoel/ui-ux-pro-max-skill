{
  "name": "@ui-ux-pro-max/design-system",
  "version": "2.0.0",
  "description": "UI/UX Pro Max - Complete design system generator with BM25 search, WCAG validation, and visual mockups",
  "keywords": [
    "design-system",
    "ui-ux",
    "css-variables",
    "color-palette",
    "typography",
    "accessibility",
    "wcag",
    "bm25-search"
  ],
  "license": "MIT",
  "author": "UI/UX Pro Max Team",
  "homepage": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git"
  },
  "bugs": {
    "url": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill/issues"
  },
  "main": "./dist/index.js",
  "bin": {
    "ui-ux-pro-max": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "data/",
    "stacks/",
    "references/",
    "design_system.py",
    "core.py",
    "reasoning_contract.py",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "search": "node bin/cli.js search",
    "design-system": "node bin/cli.js design-system",
    "validate": "python scripts/validate_data.py",
    "test": "python -m pytest scripts/tests/",
    "prepublishOnly": "npm run validate"
  },
  "dependencies": {},
  "devDependencies": {
    "pytest": "^8.0.0"
  }
}
